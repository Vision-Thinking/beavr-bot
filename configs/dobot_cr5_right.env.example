# Copy to .env.dobot_cr5_right on the right-arm server and source it before
# launching teleop/record scripts.

export DOBOT_ROBOT_HOST=192.168.5.2
export DOBOT_ROBOT_PORT=29999

# Keep dry-run enabled until the operator is beside the robot and the E-stop is
# reachable. Set to 0 only for real hardware.
export DOBOT_DRY_RUN=1

export DOBOT_SPEED_PERCENT=10
export DOBOT_ACCEL_PERCENT=10
export DOBOT_MAX_STEP_MM=5.0
export DOBOT_WORKSPACE_RADIUS_MM=100.0
export DOBOT_DEADBAND_MM=0.5

# Disable gripper during first arm-only tests if the AG-95 is not connected or
# not ready.
export DOBOT_ENABLE_GRIPPER=1
export DOBOT_GRIPPER_FORCE=30
